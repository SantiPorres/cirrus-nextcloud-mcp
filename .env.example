# --- Connection (required) ---------------------------------------------------
# Base URL of Nextcloud. Must be https.
NEXTCLOUD_URL=
# The user id (as it appears in WebDAV URLs), not an e-mail alias.
NEXTCLOUD_USER=
# An app password: Nextcloud > Settings > Security > Devices & sessions.
NEXTCLOUD_APP_PASSWORD=
# Only for local testing against a Nextcloud without TLS. Never in production.
#NEXTCLOUD_ALLOW_INSECURE_HTTP=false

# --- Permissions (all off: the server is read-only by default) ---------------
NEXTCLOUD_ALLOW_WRITE=false
NEXTCLOUD_ALLOW_DELETE=false
NEXTCLOUD_ALLOW_SHARE=false

# --- Scope --------------------------------------------------------------------
# Only this folder is visible to the tools. Empty means the whole account.
NEXTCLOUD_ROOT=
# Folder (relative to NEXTCLOUD_ROOT) inside which folders may be created.
# Empty disables folder creation.
NEXTCLOUD_FOLDER_WRITE_PREFIX=
# Extensions of text files that may be created or edited.
#NEXTCLOUD_EDITABLE_EXTENSIONS=.md,.txt,.json,.csv,.yml,.yaml,.xml,.drawio,.dio
# Spreadsheets that may be modified: glob patterns matched against the file
# name, or against the path relative to NEXTCLOUD_ROOT when the pattern has a
# "/". Empty means none. Example: Decisions*.xlsx,Plans/*/matrix.xlsx
NEXTCLOUD_EDITABLE_SPREADSHEETS=
# Sheet names that are never written to. Example: Guide,README
NEXTCLOUD_PROTECTED_SHEETS=

# --- Tool groups ---------------------------------------------------------------
# Known groups: files, sheets, safe_ops, binary, metadata, sharing, diagnostics.
# "sharing" is not in the default set and also needs NEXTCLOUD_ALLOW_SHARE.
#NEXTCLOUD_TOOL_GROUPS=files,sheets,safe_ops,binary,metadata,diagnostics

# --- Sharing policy (used by the sharing group) --------------------------------
#NEXTCLOUD_SHARE_REQUIRE_PASSWORD=true
#NEXTCLOUD_SHARE_REQUIRE_EXPIRY=true
#NEXTCLOUD_SHARE_MAX_EXPIRY_DAYS=30

# --- Server ---------------------------------------------------------------------
# stdio (default) or streamable-http. The HTTP endpoint is /mcp and does NOT
# authenticate callers: put a reverse proxy in front of it.
MCP_TRANSPORT=stdio
#MCP_HTTP_ADDR=:8000

# --- Limits ---------------------------------------------------------------------
#NEXTCLOUD_MAX_DOWNLOAD_BYTES=26214400
#NEXTCLOUD_MAX_TEXT_BYTES=2097152
# Largest file nc_download returns in one piece, largest piece of a chunked
# download or upload, and largest file that can be uploaded.
#NEXTCLOUD_MAX_EMBED_BYTES=2097152
#NEXTCLOUD_MAX_CHUNK_BYTES=1048576
#NEXTCLOUD_MAX_UPLOAD_BYTES=104857600
